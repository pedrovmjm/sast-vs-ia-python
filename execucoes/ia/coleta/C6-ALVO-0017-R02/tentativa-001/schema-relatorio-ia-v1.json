{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relatorio de achados IA v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["arquivo", "linha_inicial", "linha_final", "cwe", "severidade", "descricao", "recomendacao"],
    "properties": {
      "arquivo": {"type": "string", "minLength": 1},
      "linha_inicial": {"type": ["integer", "null"], "minimum": 1},
      "linha_final": {"type": ["integer", "null"], "minimum": 1},
      "cwe": {"type": ["string", "null"], "pattern": "^CWE-[0-9]+$"},
      "severidade": {"enum": ["baixa", "media", "alta", "critica", null]},
      "descricao": {"type": "string", "minLength": 1},
      "recomendacao": {"type": ["string", "null"]}
    }
  }
}
