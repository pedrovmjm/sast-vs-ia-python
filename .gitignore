# Planejamento e ferramentas locais que não integram o artefato final
/.specs/
/spc-driven/

# Saídas de construção e cobertura
/build/
/dist/
/htmlcov/
/.reproducao-*/
.coverage

# Sistema operacional e metadados de download
.DS_Store
Thumbs.db
*Zone.Identifier

# LaTeX/MiKTeX
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.pdf

