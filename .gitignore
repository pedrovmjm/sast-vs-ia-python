# Credenciais e configuração local
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Caches de aquisição e conteúdo cuja licença impede redistribuição
/benchmark/
/docker/regras-semgrep/

# O corpus é publicado apenas quando há licença explícita e não há segredo
/alvos/corpus-v1/*

# Entradas integrais incorporadas aos prompts permanecem reconstruíveis por hash
/resultados/ia/**/payload-codigo.json
/resultados/ia/**/prompt.txt
/resultados/ia/**/eventos.jsonl
!/resultados/ia/**/C4-*/**/eventos.jsonl
!/resultados/ia/**/C6-*/**/eventos.jsonl

# Para alvos redistribuíveis, publique também prompt, payload e eventos Cursor
!/resultados/ia/**/C*-ALVO-0002-R*/**/[ep]*
